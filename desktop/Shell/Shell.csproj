<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FreakyLoops.Shell</RootNamespace>
    <AssemblyName>FreakyLoopsStudio</AssemblyName>
    <!-- Built x64 to host modern 64-bit VST2 .dll plugins in-process. A 64-bit
         process can only load 64-bit plugins; legacy 32-bit plugins are hosted
         out-of-process by the x86 VstBridge helper (built + staged below). -->
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating version pulls the latest 1.0.x at restore time; pin once stable. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <!-- Audio device I/O. WaveOut/WASAPI now; ASIO comes with the real engine. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- VST2 (.dll) plugin hosting — pure-C# host (community-maintained). -->
    <PackageReference Include="VST.NET2-Host" Version="2.1.10" />
  </ItemGroup>

  <!-- Bundle the built Vue app (repo-root /dist) into wwwroot for both normal
       builds and `dotnet publish`, so the Release build serves the UI from its
       virtual host. Run `npm run build` first so /dist exists. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\dist')">
    <Content Include="..\..\dist\**\*.*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Bit-bridge: build the x86 VstBridge helper (its own arch, regardless of
       this x64 build) and stage its output under <out>\bridge so the app can
       spawn it for 32-bit plugins. Same staging on build, publish, and run. -->
  <PropertyGroup>
    <VstBridgeProj>$(MSBuildProjectDirectory)\..\VstBridge\VstBridge.csproj</VstBridgeProj>
    <VstBridgeOut>$(MSBuildProjectDirectory)\..\VstBridge\bin\x86\$(Configuration)\$(TargetFramework)\</VstBridgeOut>
  </PropertyGroup>

  <Target Name="BuildVstBridge" BeforeTargets="Build;Publish">
    <MSBuild Projects="$(VstBridgeProj)" Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=x86" />
    <MSBuild Projects="$(VstBridgeProj)" Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x86" />
  </Target>

  <Target Name="StageVstBridge" AfterTargets="Build" DependsOnTargets="BuildVstBridge">
    <ItemGroup>
      <_VstBridgeFiles Include="$(VstBridgeOut)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_VstBridgeFiles)"
          DestinationFiles="@(_VstBridgeFiles->'$(OutDir)bridge\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageVstBridgePublish" AfterTargets="Publish" DependsOnTargets="BuildVstBridge">
    <ItemGroup>
      <_VstBridgePubFiles Include="$(VstBridgeOut)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_VstBridgePubFiles)"
          DestinationFiles="@(_VstBridgePubFiles->'$(PublishDir)bridge\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
