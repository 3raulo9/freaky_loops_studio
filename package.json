{
  "name": "freaky-loops-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "cargo run -p fls-host",
    "desktop:bridge": "cargo build -p fls-bridge --target i686-pc-windows-msvc",
    "desktop:build": "npm run build && node scripts/package-desktop.mjs",
    "build:dsp": "cargo build -p fls-dsp --target wasm32-unknown-unknown --release && node -e \"require('fs').copyFileSync('target/wasm32-unknown-unknown/release/fls_dsp.wasm','src/wasm/fls_dsp.wasm')\""
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "soundfont-player": "^0.12.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.60.0",
    "vite": "^6.3.5"
  }
}
